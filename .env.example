# Mobile app (Expo)
# Copy these into `apps/mobile/.env` when running the Expo app from `apps/mobile`.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy fallback if your Supabase project still exposes an anon key.
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Root scripts (`scripts/import-content.ts` reads `.env.local` first, then falls back to `.env`)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional legacy fallback.
# SUPABASE_SERVICE_ROLE_KEY=
